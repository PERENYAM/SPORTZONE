# All optional. The site runs in demo mode without them.
TMDB_API_KEY=            # free: themoviedb.org/settings/api (movies and TV)
SPORTS_API_KEY=          # api-sports.io dashboard. Free plan: 100 requests/day per sport
SPORTS_REVALIDATE_SECONDS=1800   # lower only on a paid plan
DATABASE_URL=            # postgres://user:pass@host:5432/dbname (tables are created automatically)
AUTH_SECRET=             # any random text, 32+ characters
AUTHORIZED_SOURCES=      # JSON, e.g. {"movie:123":"https://your-cdn.example/movie.m3u8"} (only streams you may serve)
